# Prod only. us-east-1 account 471550468381.
# Keep this file outside .ebextensions so a nonprod deploy cannot apply it.
# REDIS_URL and CELERY_BROKER_URL use the primary endpoint of
# edmp-gdxp-admin-prod-redis on database 0. Do not use the us-west-2 host.
# DB_HOST is the endpoint of edmp-gdxp-admin-prod-rds.
# DB_PASSWORD and GDXP_SECRET_KEY are set on the prod environment, not in this file.
option_settings:
  aws:elasticbeanstalk:application:environment:
    DJANGO_SETTINGS_MODULE: gdx.settings.prod
    DJANGO_ENV: prod
    APP_ENV: prod
    DJANGO_DEBUG: "false"
    DJANGO_ALLOWED_HOSTS: admin.data.toyota.com
    DJANGO_CSRF_TRUSTED_ORIGINS: https://admin.data.toyota.com
    DJANGO_SECURE_SSL_REDIRECT: "true"
    DJANGO_SESSION_COOKIE_SECURE: "true"
    DJANGO_CSRF_COOKIE_SECURE: "true"
    AWS_REGION: us-east-1
    AWS_STORAGE_BUCKET_NAME: edmp-gdxp-admin-use1-s3-web
    DB_PORT: "5432"
    DB_SSLMODE: require
    DB_NAME: edmp_gdxp_admin_prod_rds
    DB_USER: Administrator
    CELERY_RESULT_BACKEND: django-db
    EMAIL_BACKEND: gdx.email.SesEmailBackend
    AWS_SES_REGION: us-east-1
    AWS_SES_CONFIGURATION_SET: edmp-gdxp-admin-prod-mail
    DEFAULT_FROM_EMAIL: no-reply@data.toyota.com
    SERVER_EMAIL: no-reply@data.toyota.com
