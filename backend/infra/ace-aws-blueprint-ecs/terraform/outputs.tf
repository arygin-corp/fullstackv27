output "acm_certificate_arns" {
  value = local.acm_certificate_arn
}

output "aws_ecs_task_definition_arn" {
  value = module.ecs-service.aws_ecs_task_definition_arn
}

output "database_address" {
  value = local.use_db ? module.database[0].database_address : null
}

output "database_parameter_arn_map" {
  value = local.use_db ? module.database[0].database_parameter_arn_map : null
}

output "database_port" {
  value = local.use_db ? module.database[0].database_port : null
}

output "database_security_group_id" {
  value = local.use_db ? module.database[0].database_security_group_id : null
}

output "ecs_cluster_arn" {
  description = "ECS Cluster ARN"
  value = (!var.create_ecs_cluster ? data.aws_ecs_cluster.ecs_cluster[0].arn
  : var.ecs_service_launch_type == "FARGATE" ? module.ecs_cluster[0].ecs_cluster_arn : module.ecs_ec2_cluster[0].cluster_arn)
}

output "ecs_service_security_group_id" {
  value = module.ecs-service.service_security_group_id
}

output "ecs_task_execution_iam_role_arn" {
  value = module.ecs-service.ecs_task_execution_iam_role_arn
}

output "ecs_task_execution_iam_role_name" {
  value = module.ecs-service.ecs_task_execution_iam_role_name
}

output "ecs_task_iam_role_arn" {
  value = module.ecs-service.ecs_task_iam_role_arn
}

output "ecs_task_iam_role_name" {
  value = module.ecs-service.ecs_task_iam_role_name
}

output "hostname" {
  value = (local.use_nlb || local.use_alb || local.use_existing_nlb || local.use_existing_alb) && local.create_new_acm_cert ? module.route53_record[0].hostname : null
}

output "lb_arn" {
  value = local.use_nlb ? try(module.nlb[0].nlb_arn, null) : (var.existing_lb_name == null ? try(module.alb[0].alb_arn, null) : try(data.aws_lb.existing_lb[0].arn, null))
}

output "lb_dns_name" {
  value = local.is_using_lb ? (local.use_nlb || local.use_existing_nlb ? (local.use_nlb ? module.nlb[0].nlb_dns_name : data.aws_lb.existing_lb[0].dns_name) : (local.use_existing_alb ? data.aws_lb.existing_lb[0].dns_name : module.alb[0].alb_dns_name)) : null
}

output "lb_zone_id" {
  value = local.is_using_lb ? (
    local.use_nlb || local.use_existing_nlb ?
    (local.use_nlb ? module.nlb[0].nlb_zone_id : data.aws_lb.existing_lb[0].zone_id) :
    (local.use_existing_alb ? data.aws_lb.existing_lb[0].zone_id : module.alb[0].alb_hosted_zone_id)
  ) : null
}

output "waf2_acl_id" {
  description = "WAF ACL ID generated by the module"
  value       = local.use_alb && var.existing_waf_acl_arn != null ? split("/", var.existing_waf_acl_arn)[length(split("/", var.existing_waf_acl_arn)) - 1] : try(module.waf[0].waf2_acl_id, null)
}

output "waf2_acl_arn" {
  description = "WAF ACL ARN generated by the module"
  value       = local.use_alb && var.existing_waf_acl_arn != null ? var.existing_waf_acl_arn : try(module.waf[0].waf2_acl_arn, null)
}

output "cloudwatch_log_group_name" {
  value = module.cw_ecs_logs.log_group_name
}

# KMS Outputs
output "kms_key_arn" {
  description = "ARN of the KMS key used for encryption"
  value       = var.cw_existing_key_arn != null ? var.cw_existing_key_arn != null : module.kms_master_key[0].key_arns[local.default_kms_key_name]
}

# Access Logging Status Outputs
output "nlb_access_logging_enabled" {
  description = "Whether access logging is enabled for NLB"
  value       = local.use_nlb ? var.access_logging_enabled : null
}

output "alb_access_logging_enabled" {
  description = "Whether access logging is enabled for ALB"
  value       = local.use_alb ? var.access_logging_enabled : null
}

output "waf_logging_enabled" {
  description = "Whether logging is enabled for WAF"
  value       = local.use_alb ? var.waf_use_kinesis || length(var.waf_kinesis_firehose_stream_arns) > 0 : null
}

output "lb_access_logs_s3_bucket_name" {
  description = "S3 bucket name for load balancer access logs"
  value = var.lb_access_logs_s3_bucket_name != null ? var.lb_access_logs_s3_bucket_name : (
    local.use_nlb ? module.nlb[0].nlb_access_logs_s3_bucket_name :
    local.use_alb ? split(":", module.alb[0].bucket_arn)[5] :
    null
  )
}
