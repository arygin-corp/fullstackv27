module "secret"{source="../secrets";name=var.secret_name;environment=var.environment;secret_value=var.secret_values;tags=var.tags}
module "app_sg"{source="../security-group";name="${var.name_prefix}-app-sg";description="GDXP Admin application";vpc_id=var.vpc_id;environment=var.environment;ingress_rules=[{from_port=8000,to_port=8000,protocol="tcp",source_security_group_id=var.alb_security_group_id,cidr_blocks=[]}];egress_rules=[{from_port=443,to_port=443,protocol="tcp",cidr_blocks=["0.0.0.0/0"]}];tags=var.tags}
module "db_sg"{source="../security-group";name="${var.name_prefix}-db-sg";description="GDXP Admin PostgreSQL";vpc_id=var.vpc_id;environment=var.environment;ingress_rules=[{from_port=5432,to_port=5432,protocol="tcp",source_security_group_id=module.app_sg.security_group_id,cidr_blocks=[]}];tags=var.tags}
module "redis_sg"{source="../security-group";name="${var.name_prefix}-redis-sg";description="GDXP Admin Redis";vpc_id=var.vpc_id;environment=var.environment;ingress_rules=[{from_port=6379,to_port=6379,protocol="tcp",source_security_group_id=module.app_sg.security_group_id,cidr_blocks=[]}];tags=var.tags}
resource "aws_vpc_security_group_egress_rule" "db"{security_group_id=module.app_sg.security_group_id;from_port=5432;to_port=5432;ip_protocol="tcp";referenced_security_group_id=module.db_sg.security_group_id}
resource "aws_vpc_security_group_egress_rule" "redis"{security_group_id=module.app_sg.security_group_id;from_port=6379;to_port=6379;ip_protocol="tcp";referenced_security_group_id=module.redis_sg.security_group_id}
module "rds"{source="../rds";identifier="${var.name_prefix}-rds";db_name=var.db_name;db_subnet_group_name=var.db_subnet_group_name;security_group_ids=[module.db_sg.security_group_id];secret_arn=module.secret.secret_arn;environment=var.environment;tags=var.tags}
module "redis"{source="../redis";replication_group_id="${var.name_prefix}-redis";subnet_group_name=var.redis_subnet_group_name;security_group_ids=[module.redis_sg.security_group_id];environment=var.environment;tags=var.tags}
# IAM is created before bucket policy; placeholder bucket ARN is deterministic.
module "iam"{source="../ecs-iam";name_prefix=var.name_prefix;secret_arn=module.secret.secret_arn;bucket_arn="arn:aws:s3:::${var.application_bucket_name}";environment=var.environment;tags=var.tags}
module "application_s3"{source="../application-s3";bucket_name=var.application_bucket_name;environment=var.environment;task_role_arn=module.iam.task_role_arn;tags=var.tags}
module "target_group"{source="../target-group";name="${var.name_prefix}-tg";vpc_id=var.vpc_id;listener_arn=var.listener_arn;host_name=var.admin_host;priority=var.listener_priority;environment=var.environment;tags=var.tags}
locals{runtime={APP_ENV=var.environment,DJANGO_SETTINGS_MODULE=var.settings_module,DJANGO_ALLOWED_HOSTS=var.admin_host,DJANGO_CSRF_TRUSTED_ORIGINS="https://${var.admin_host}",DJANGO_CORS_ALLOWED_ORIGINS=var.angular_origin,AWS_REGION=data.aws_region.current.name,AWS_STORAGE_BUCKET_NAME=module.application_s3.bucket_name,AWS_S3_MEDIA_PREFIX="media",AWS_S3_DATA_PREFIX="data",DB_HOST=module.rds.endpoint,DB_PORT="5432",DB_NAME=var.db_name,DB_SSLMODE="require",REDIS_URL="rediss://${module.redis.primary_endpoint}:6379/0",CELERY_BROKER_URL="rediss://${module.redis.primary_endpoint}:6379/0",CELERY_RESULT_BACKEND="django-db"};secret_keys=keys(var.secret_values)}
data "aws_region" "current"{}
module "web"{source="../ecs-workload";name="${var.name_prefix}-web";cluster_arn=var.cluster_arn;image_uri=var.image_uri;command=["/app/scripts/web.sh"];subnet_ids=var.private_subnet_ids;security_group_ids=[module.app_sg.security_group_id];execution_role_arn=module.iam.execution_role_arn;task_role_arn=module.iam.task_role_arn;environment_variables=local.runtime;secret_arn=module.secret.secret_arn;secret_keys=local.secret_keys;target_group_arn=module.target_group.target_group_arn;environment=var.environment;tags=var.tags}
module "worker"{source="../ecs-workload";name="${var.name_prefix}-worker";cluster_arn=var.cluster_arn;image_uri=var.image_uri;command=["/app/scripts/worker.sh"];subnet_ids=var.private_subnet_ids;security_group_ids=[module.app_sg.security_group_id];execution_role_arn=module.iam.execution_role_arn;task_role_arn=module.iam.task_role_arn;environment_variables=local.runtime;secret_arn=module.secret.secret_arn;secret_keys=local.secret_keys;target_group_arn=null;environment=var.environment;tags=var.tags}
module "beat"{source="../ecs-workload";name="${var.name_prefix}-beat";cluster_arn=var.cluster_arn;image_uri=var.image_uri;command=["/app/scripts/beat.sh"];desired_count=1;subnet_ids=var.private_subnet_ids;security_group_ids=[module.app_sg.security_group_id];execution_role_arn=module.iam.execution_role_arn;task_role_arn=module.iam.task_role_arn;environment_variables=local.runtime;secret_arn=module.secret.secret_arn;secret_keys=local.secret_keys;target_group_arn=null;environment=var.environment;tags=var.tags}
module "migration"{source="../ecs-workload";name="${var.name_prefix}-migration";cluster_arn=var.cluster_arn;image_uri=var.image_uri;command=["/app/scripts/migrate.sh"];desired_count=0;create_service=false;subnet_ids=var.private_subnet_ids;security_group_ids=[module.app_sg.security_group_id];execution_role_arn=module.iam.execution_role_arn;task_role_arn=module.iam.task_role_arn;environment_variables=local.runtime;secret_arn=module.secret.secret_arn;secret_keys=local.secret_keys;target_group_arn=null;environment=var.environment;tags=var.tags}
module "dns"{count=var.route53_zone_id!=""?1:0;source="../route53";zone_id=var.route53_zone_id;record_name=var.admin_host;alb_dns_name=var.alb_dns_name;alb_zone_id=var.alb_zone_id}
