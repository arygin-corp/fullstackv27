{
  "name": "fullstack-master-v2",
  "version": "2.0.0",
  "private": true,
  "description": "Code-only full-stack orchestration for GDX Django 4.2 ASGI/WSGI and Angular 13",
  "scripts": {
    "setup": "npm install && node scripts/setup-python.js && npm --prefix frontend install",
    "setup:backend": "node scripts/setup-python.js",
    "setup:frontend": "npm --prefix frontend install",
    "backend": "node scripts/backend.js runserver 8000",
    "frontend": "npm --prefix frontend start",
    "local": "concurrently --kill-others-on-fail --names BACKEND,FRONTEND --prefix-colors blue,magenta \"npm run asgi:local\" \"npm run frontend\"",
    "dev": "concurrently --kill-others-on-fail --names BACKEND,FRONTEND --prefix-colors blue,magenta \"npm run backend\" \"npm run frontend\"",
    "migrate": "node scripts/backend.js migrate",
    "makemigrations": "node scripts/backend.js makemigrations",
    "createsuperuser": "node scripts/backend.js createsuperuser",
    "django-check": "node scripts/backend.js check",
    "django-check:deploy": "node scripts/backend.js check --deploy",
    "collectstatic": "node scripts/backend.js collectstatic --noinput",
    "test:backend": "node scripts/backend.js test",
    "test:frontend": "npm --prefix frontend test",
    "test:frontend:ci": "npm --prefix frontend run test:ci",
    "build:frontend:local": "node scripts/build-root.js frontend local",
    "build:frontend:dev": "node scripts/build-root.js frontend dev",
    "build:frontend:qa": "node scripts/build-root.js frontend qa",
    "build:frontend:demo": "node scripts/build-root.js frontend demo",
    "build:frontend:stage": "node scripts/build-root.js frontend stage",
    "build:frontend:prod": "node scripts/build-root.js frontend prod",
    "build:all:local": "node scripts/build-root.js all local",
    "build:all:dev": "node scripts/build-root.js all dev",
    "build:all:qa": "node scripts/build-root.js all qa",
    "build:all:demo": "node scripts/build-root.js all demo",
    "build:all:stage": "node scripts/build-root.js all stage",
    "build:all:prod": "node scripts/build-root.js all prod",
    "ci:backend": "node scripts/ci-build.js backend prod",
    "ci:frontend": "node scripts/ci-build.js frontend prod",
    "ci:all": "node scripts/ci-build.js all prod",
    "clean": "node scripts/clean.js",
    "mind-map": "node scripts/mind-map.js",
    "validate:wrapper": "node --check scripts/backend.js && node --check scripts/django.js && node --check scripts/setup-python.js && node --check scripts/build-root.js && node --check scripts/ci-build.js && node --check scripts/clean.js && node --check frontend/build/build.js && node --check scripts/asgi.js && node --check scripts/verify-runtime.js",
    "backend:local": "node scripts/django.js run local runserver 8000",
    "build:backend:local": "node scripts/build-root.js backend local",
    "check:backend:local": "node scripts/django.js check local",
    "collectstatic:local": "node scripts/django.js collectstatic local",
    "migrate:local": "node scripts/django.js migrate local",
    "build:backend:dev": "node scripts/build-root.js backend dev",
    "check:backend:dev": "node scripts/django.js check dev",
    "collectstatic:dev": "node scripts/django.js collectstatic dev",
    "migrate:dev": "node scripts/django.js migrate dev",
    "build:backend:demo": "node scripts/build-root.js backend demo",
    "check:backend:demo": "node scripts/django.js check demo",
    "collectstatic:demo": "node scripts/django.js collectstatic demo",
    "migrate:demo": "node scripts/django.js migrate demo",
    "build:backend:qa": "node scripts/build-root.js backend qa",
    "check:backend:qa": "node scripts/django.js check qa",
    "collectstatic:qa": "node scripts/django.js collectstatic qa",
    "migrate:qa": "node scripts/django.js migrate qa",
    "build:backend:stage": "node scripts/build-root.js backend stage",
    "check:backend:stage": "node scripts/django.js check stage",
    "collectstatic:stage": "node scripts/django.js collectstatic stage",
    "migrate:stage": "node scripts/django.js migrate stage",
    "build:backend:prod": "node scripts/build-root.js backend prod",
    "check:backend:prod": "node scripts/django.js check prod",
    "collectstatic:prod": "node scripts/django.js collectstatic prod",
    "migrate:prod": "node scripts/django.js migrate prod",
    "asgi:local": "node scripts/asgi.js local",
    "asgi:dev": "node scripts/asgi.js dev",
    "asgi:demo": "node scripts/asgi.js demo",
    "asgi:qa": "node scripts/asgi.js qa",
    "asgi:stage": "node scripts/asgi.js stage",
    "asgi:prod": "node scripts/asgi.js prod",
    "verify:runtime": "node scripts/verify-runtime.js local",
    "verify:runtime:local": "node scripts/verify-runtime.js local",
    "verify:runtime:dev": "node scripts/verify-runtime.js dev",
    "verify:runtime:demo": "node scripts/verify-runtime.js demo",
    "verify:runtime:qa": "node scripts/verify-runtime.js qa",
    "verify:runtime:stage": "node scripts/verify-runtime.js stage",
    "verify:runtime:prod": "node scripts/verify-runtime.js prod"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
