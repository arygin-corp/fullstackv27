# QA only. Do not copy this file into .ebextensions while the dev bundle is deployed.
option_settings:
  aws:elasticbeanstalk:application:environment:
    DJANGO_SETTINGS_MODULE: gdx.settings.qa
    DJANGO_ENV: qa
    APP_ENV: qa
    DJANGO_ALLOWED_HOSTS: .elasticbeanstalk.com,admin.qa.data.toyota.com
    DJANGO_CSRF_TRUSTED_ORIGINS: https://admin.qa.data.toyota.com,http://.elasticbeanstalk.com
    AWS_STORAGE_BUCKET_NAME: edmp-gdxp-nonprod-qa-admin
    REDIS_URL: rediss://master.edmp-gdxp-admin-nonprod-redis.ukx1ws.usw2.cache.amazonaws.com:6379/2
    CELERY_BROKER_URL: rediss://master.edmp-gdxp-admin-nonprod-redis.ukx1ws.usw2.cache.amazonaws.com:6379/2
    EMAIL_BACKEND: gdx.email.SesEmailBackend
    AWS_SES_REGION: us-west-2
    AWS_SES_CONFIGURATION_SET: edmp-gdxp-admin-nonprod-mail
    DEFAULT_FROM_EMAIL: no-reply@qa.data.toyota.com
    SERVER_EMAIL: no-reply@qa.data.toyota.com
