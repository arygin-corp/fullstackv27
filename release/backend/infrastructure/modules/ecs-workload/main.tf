resource "aws_cloudwatch_log_group" "this"{name="/ecs/${var.name}";retention_in_days=30;tags=merge(var.tags,{"tmna:environment"=var.environment})}
locals{env=[for k,v in var.environment_variables:{name=k,value=v}];secrets=[for k in var.secret_keys:{name=k,valueFrom="${var.secret_arn}:${k}::"}]}
resource "aws_ecs_task_definition" "this"{family=var.name;requires_compatibilities=["FARGATE"];network_mode="awsvpc";cpu=tostring(var.cpu);memory=tostring(var.memory);execution_role_arn=var.execution_role_arn;task_role_arn=var.task_role_arn;container_definitions=jsonencode([{name=var.name,image=var.image_uri,essential=true,command=var.command,portMappings=var.target_group_arn==null?[]:[{containerPort=var.container_port,hostPort=var.container_port,protocol="tcp"}],environment=local.env,secrets=local.secrets,logConfiguration={logDriver="awslogs",options={"awslogs-group"=aws_cloudwatch_log_group.this.name,"awslogs-region"=data.aws_region.current.name,"awslogs-stream-prefix"="ecs"}}}]);tags=merge(var.tags,{"tmna:environment"=var.environment})}
data "aws_region" "current"{}
resource "aws_ecs_service" "this"{count=var.create_service?1:0;name=var.name;cluster=var.cluster_arn;task_definition=aws_ecs_task_definition.this.arn;desired_count=var.desired_count;launch_type="FARGATE";platform_version="LATEST";enable_execute_command=true;deployment_minimum_healthy_percent=100;deployment_maximum_percent=200;network_configuration{subnets=var.subnet_ids;security_groups=var.security_group_ids;assign_public_ip=false};dynamic"load_balancer"{for_each=var.target_group_arn==null?[]:[var.target_group_arn];content{target_group_arn=load_balancer.value;container_name=var.name;container_port=var.container_port}};tags=merge(var.tags,{"tmna:environment"=var.environment});lifecycle{ignore_changes=[task_definition]}}
