resource "aws_security_group" "this"{name=var.name;description=var.description;vpc_id=var.vpc_id;revoke_rules_on_delete=true;tags=merge(var.tags,{"Name"=var.name,"tmna:environment"=var.environment})}
resource "aws_vpc_security_group_ingress_rule" "sg"{for_each={for i,r in var.ingress_rules:i=>r if try(r.source_security_group_id,null)!=null};security_group_id=aws_security_group.this.id;from_port=each.value.from_port;to_port=each.value.to_port;ip_protocol=each.value.protocol;referenced_security_group_id=each.value.source_security_group_id}
resource "aws_vpc_security_group_ingress_rule" "cidr"{for_each={for x in flatten([for i,r in var.ingress_rules:[for c in r.cidr_blocks:{k="${i}-${c}",r=r,c=c}] ]):x.k=>x};security_group_id=aws_security_group.this.id;from_port=each.value.r.from_port;to_port=each.value.r.to_port;ip_protocol=each.value.r.protocol;cidr_ipv4=each.value.c}
resource "aws_vpc_security_group_egress_rule" "sg"{for_each={for i,r in var.egress_rules:i=>r if try(r.destination_security_group_id,null)!=null};security_group_id=aws_security_group.this.id;from_port=each.value.from_port;to_port=each.value.to_port;ip_protocol=each.value.protocol;referenced_security_group_id=each.value.destination_security_group_id}
resource "aws_vpc_security_group_egress_rule" "cidr"{for_each={for x in flatten([for i,r in var.egress_rules:[for c in r.cidr_blocks:{k="${i}-${c}",r=r,c=c}] ]):x.k=>x};security_group_id=aws_security_group.this.id;from_port=each.value.r.from_port;to_port=each.value.r.to_port;ip_protocol=each.value.r.protocol;cidr_ipv4=each.value.c}
