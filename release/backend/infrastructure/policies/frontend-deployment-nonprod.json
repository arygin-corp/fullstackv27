{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListFrontendBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::edmp-nonprod-demo-gdx",
        "arn:aws:s3:::edmp-nonprod-dev-gdx",
        "arn:aws:s3:::edmp-nonprod-qa-gdx",
        "arn:aws:s3:::edmp-nonprod-stage-gdx"
      ]
    },
    {
      "Sid": "ManageFrontendObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::edmp-nonprod-demo-gdx/*",
        "arn:aws:s3:::edmp-nonprod-dev-gdx/*",
        "arn:aws:s3:::edmp-nonprod-qa-gdx/*",
        "arn:aws:s3:::edmp-nonprod-stage-gdx/*"
      ]
    }
  ]
}