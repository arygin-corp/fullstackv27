{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListFrontendBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::edmp-prod-gdx"
      ]
    },
    {
      "Sid": "ManageFrontendObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::edmp-prod-gdx/*"
      ]
    }
  ]
}