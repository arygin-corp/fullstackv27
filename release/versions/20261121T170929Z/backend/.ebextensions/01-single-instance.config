option_settings:
  aws:elasticbeanstalk:environment:
    EnvironmentType: SingleInstance
  aws:elasticbeanstalk:environment:proxy:
    ProxyServer: nginx
  aws:autoscaling:launchconfiguration:
    InstanceType: t3.large
    RootVolumeType: gp3
    RootVolumeSize: 30
    SecurityGroups: sg-0165f33a5691a590a
    IamInstanceProfile: edmp-gdxp-nonprod-ec2-role
  aws:ec2:vpc:
    VPCId: vpc-064d050c9dc2f2863
    Subnets: subnet-0377bd2b513381dd2
    AssociatePublicIpAddress: true
  aws:elasticbeanstalk:application:environment:
    DJANGO_DEBUG: "false"
    DJANGO_SECURE_SSL_REDIRECT: "false"
    DJANGO_SESSION_COOKIE_SECURE: "false"
    DJANGO_CSRF_COOKIE_SECURE: "false"
    AWS_REGION: us-west-2
    CELERY_RESULT_BACKEND: django-db
    EMAIL_BACKEND: gdx.email.SesEmailBackend
    AWS_SES_REGION: us-west-2
    AWS_SES_CONFIGURATION_SET: edmp-gdxp-admin-nonprod-mail
