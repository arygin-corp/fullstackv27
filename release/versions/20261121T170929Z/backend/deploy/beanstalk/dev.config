# Dev only. Beanstalk applies every .config file under .ebextensions, so this
# file stays outside that folder. These values are saved on the dev environment.
option_settings:
  aws:elasticbeanstalk:application:environment:
    DJANGO_SETTINGS_MODULE: gdx.settings.dev
    DJANGO_ENV: dev
    APP_ENV: dev
    DJANGO_ALLOWED_HOSTS: .elasticbeanstalk.com,admin.dev.data.toyota.com
    DJANGO_CSRF_TRUSTED_ORIGINS: https://admin.dev.data.toyota.com,http://.elasticbeanstalk.com
    AWS_STORAGE_BUCKET_NAME: edmp-gdxp-nonprod-dev-admin
    REDIS_URL: rediss://master.edmp-gdxp-admin-nonprod-redis.ukx1ws.usw2.cache.amazonaws.com:6379/1
    CELERY_BROKER_URL: rediss://master.edmp-gdxp-admin-nonprod-redis.ukx1ws.usw2.cache.amazonaws.com:6379/1
    EMAIL_BACKEND: gdx.email.SesEmailBackend
    AWS_SES_REGION: us-west-2
    AWS_SES_CONFIGURATION_SET: edmp-gdxp-admin-nonprod-mail
    DEFAULT_FROM_EMAIL: no-reply@dev.data.toyota.com
    SERVER_EMAIL: no-reply@dev.data.toyota.com
